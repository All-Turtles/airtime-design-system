          "use": "Filled accent and destructive buttons."
        }
      }
    },
    "card": {
      "$value": "inset 0 0 0 0.5px {colors.lighting.highlightPrimary}, 0 4px 16px 1px {colors.shadow.small}",
      "$type": "shadow",
      "$extensions": {
