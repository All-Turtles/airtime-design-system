{
  "$name": "Creator - shadows",
  "$description": "Design tokens for the Creator app. Each token's $extensions.creator records its CSS variable, kind, rendered value in light and dark, and its relation to the Airtime design system.",
  "shadow": {
    "sm": {
      "$value": "0 1px 2px 0 {colors.shadow.small}",
      "$type": "shadow",
      "$extensions": {
        "creator": {
          "css": "--cr-shadow-sm",
          "kind": "semantic",
          "status": "declared",
          "rendered": {
            "light": "0 1px 2px 0 rgba(0, 0, 0, 0.08)",
            "dark": "0 1px 2px 0 rgba(0, 0, 0, 0.24)"
          },
          "org": {
            "relation": "creator-only"
          },
          "alias": null,
          "used": {
            "all": 0
          },
          "use": "Small controls: a 1px contact shadow."
        }
      }
    },
    "md": {
      "$value": "0 8px 16px 0 {colors.shadow.medium}",
      "$type": "shadow",
      "$extensions": {
        "creator": {
          "css": "--cr-shadow-md",
          "kind": "semantic",
          "status": "declared",
          "rendered": {
            "light": "0 8px 16px 0 rgba(0, 0, 0, 0.16)",
            "dark": "0 8px 16px 0 rgba(0, 0, 0, 0.48)"
          },
          "org": {
            "relation": "creator-only"
          },
          "alias": null,
          "used": {
            "all": 3
          },
          "use": "Floating bars and stage glass."
        }
      }
    },
    "lg": {
      "$value": "0 16px 32px 0 {colors.shadow.large}",
      "$type": "shadow",
      "$extensions": {
        "creator": {
          "css": "--cr-shadow-lg",
          "kind": "semantic",
          "status": "declared",
          "rendered": {
            "light": "0 16px 32px 0 rgba(0, 0, 0, 0.24)",
            "dark": "0 16px 32px 0 rgba(0, 0, 0, 0.72)"
          },
          "org": {
            "relation": "creator-only"
          },
          "alias": null,
          "used": {
            "all": 0
          },
          "use": "The deepest drop; menus and sheets."
        }
      }
    },
    "up": {
      "$value": "0 -8px 16px 0 {colors.shadow.medium}",
      "$type": "shadow",
      "$extensions": {
        "creator": {
          "css": "--cr-shadow-up",
          "kind": "semantic",
          "status": "declared",
          "rendered": {
            "light": "0 -8px 16px 0 rgba(0, 0, 0, 0.16)",
            "dark": "0 -8px 16px 0 rgba(0, 0, 0, 0.48)"
          },
          "org": {
            "relation": "creator-only"
          },
          "alias": null,
          "used": {
            "all": 0
          },
          "use": "A surface rising from the bottom edge."
        }
      }
    },
    "raised": {
      "$value": "inset 0 0.5px 0 0 {colors.lighting.highlightPrimary}, 0 0 0 0.5px {colors.shadow.medium}, 0 1px 2px 0 {colors.shadow.small}",
      "$type": "shadow",
      "$extensions": {
        "creator": {
          "css": "--cr-shadow-raised",
          "kind": "semantic",
          "status": "declared",
          "rendered": {
            "light": "inset 0 0.5px 0 0 rgba(255, 255, 255, 0.92), 0 0 0 0.5px rgba(0, 0, 0, 0.16), 0 1px 2px 0 rgba(0, 0, 0, 0.08)",
            "dark": "inset 0 0.5px 0 0 rgba(255, 255, 255, 0.08), 0 0 0 0.5px rgba(0, 0, 0, 0.48), 0 1px 2px 0 rgba(0, 0, 0, 0.24)"
          },
          "org": {
            "relation": "creator-only"
          },
          "alias": null,
          "used": {
            "all": 7
          },
          "use": "Secondary buttons, segment thumbs and chips."
        }
      }
    },
    "raisedPressed": {
      "$value": "0 0 0 0.5px {colors.shadow.medium}",
      "$type": "shadow",
