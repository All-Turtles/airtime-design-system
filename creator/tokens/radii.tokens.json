{
  "$name": "Creator - radii",
  "$description": "Design tokens for the Creator app. Each token's $extensions.creator records its CSS variable, kind, rendered value in light and dark, and its relation to the Airtime design system.",
  "radius": {
    "stage": {
      "$value": "8px",
      "$type": "dimension",
      "$extensions": {
        "creator": {
          "css": "--cr-radius-stage",
          "kind": "primitive",
          "status": "declared",
          "rendered": {
            "light": "8px",
            "dark": "8px"
          },
          "org": {
            "relation": "same",
            "org": "--radius-20",
            "note": "value 8px equals org --radius-20"
          },
          "alias": "--radius-20",
          "used": {
            "all": 0
          }
        }
      }
    },
    "selectionTrack": {
