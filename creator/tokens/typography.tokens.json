    "body": {
      "$value": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'SF Pro Display', 'Helvetica Neue', Helvetica, Arial, sans-serif",
      "$type": "fontFamily",
      "$extensions": {
        "creator": {
          "css": "--cr-font-family-body",
          "kind": "primitive",
          "status": "declared",
          "rendered": {
            "light": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'SF Pro Display', 'Helvetica Neue', Helvetica, Arial, sans-serif",
            "dark": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'SF Pro Display', 'Helvetica Neue', Helvetica, Arial, sans-serif"
          },
          "org": {
            "relation": "differs"
          },
          "alias": null,
          "used": {
            "all": 20
          }
        }
      }
    },
