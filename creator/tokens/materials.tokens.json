{
  "$name": "Creator - materials",
  "$description": "Design tokens for the Creator app. Each token's $extensions.creator records its CSS variable, kind, rendered value in light and dark, and its relation to the Airtime design system.",
  "blur": {
    "small": {
      "$value": "8px",
      "$type": "dimension",
      "$extensions": {
        "creator": {
          "css": "--cr-blur-small",
          "kind": "primitive",
          "status": "declared",
          "rendered": {
            "light": "8px",
            "dark": "8px"
          },
          "org": {
            "relation": "creator-only"
          },
          "alias": null,
          "used": {
            "all": 6
          }
        }
      }
    },
    "large": {
      "$value": "32px",
      "$type": "dimension",
      "$extensions": {
        "creator": {
          "css": "--cr-blur-large",
          "kind": "primitive",
          "status": "declared",
          "rendered": {
            "light": "32px",
            "dark": "32px"
          },
          "org": {
            "relation": "creator-only"
          },
          "alias": null,
          "used": {
            "all": 8
          }
        }
      }
    }
  }
}
