      "$value": "120ms",
      "$type": "duration",
      "$extensions": {
        "creator": {
          "css": "--cr-duration-insert",
          "kind": "primitive",
          "status": "declared",
          "rendered": {
            "light": "120ms",
            "dark": "120ms"
          },
          "org": {
            "relation": "creator-only",
            "note": "no org duration token has value 120ms"
          },
          "alias": null,
          "used": {
            "all": 0
